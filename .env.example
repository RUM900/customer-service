# ============================================================
# LLM Provider — 选择 "dashscope" | "openai" | "claude"
# ============================================================
LLM_PROVIDER=dashscope

# --- DashScope (阿里云) ---
# 用于 FAQ/知识库的向量嵌入（text-embedding-v1 中文向量模型）
DASHSCOPE_API_KEY=your_dashscope_api_key_here
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v1

# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Claude (Anthropic) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ============================================================
# 模型配置
# ============================================================
# MODEL_TRIAGE=qwen-plus
# MODEL_SPECIALIST=qwen-plus
# MODEL_SUPERVISOR=qwen-plus

# ============================================================
# PostgreSQL（生产环境用；开发默认 SQLite 零配置）
# ============================================================
# DATABASE_URL=sqlite+aiosqlite:///./customer_service.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/customer_service

# ============================================================
# 管理员认证（JWT）
# ============================================================
# JWT_SECRET=change-me-in-prod
# JWT_EXPIRE_HOURS=24
# 首次启动自动创建的默认管理员
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin123
# 管理员修改模型名时是否探活校验
# MODEL_VALIDATION_ENABLED=true

# ============================================================
# ChromaDB
# ============================================================
# CHROMA_PERSIST_DIR=data/chroma
# CHROMA_COLLECTION_NAME=faq_knowledge

# ============================================================
# API
# ============================================================
# API_HOST=0.0.0.0
# API_PORT=8000
# CORS_ORIGINS=*

# ============================================================
# LLM Provider — 选择 "dashscope" | "openai" | "claude"
# ============================================================
LLM_PROVIDER=dashscope

# --- DashScope (阿里云) ---
DASHSCOPE_API_KEY=your_dashscope_api_key_here
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- OpenAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Claude (Anthropic) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ============================================================
# 模型配置
# ============================================================
# MODEL_TRIAGE=qwen-plus
# MODEL_SPECIALIST=qwen-plus
# MODEL_SUPERVISOR=qwen-plus

# ============================================================
# PostgreSQL
# ============================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/customer_service

# ============================================================
# ChromaDB
# ============================================================
# CHROMA_PERSIST_DIR=data/chroma
# CHROMA_COLLECTION_NAME=faq_knowledge

# ============================================================
# API
# ============================================================
# API_HOST=0.0.0.0
# API_PORT=8000
# CORS_ORIGINS=*
